{
  "lunaut.platform": "auto",
  "lunaut.fflags.enableByDefault": false,
  "lunaut.fflags.sync": true,
  "lunaut.fflags.enableNewSolver": true,
  "lunaut.fflags.override": {},
  "lunaut.roblox.downloadTypes": true,
  "lunaut.roblox.securityLevel": "PluginSecurity",
  "lunaut.rojo.enabled": true,
  "lunaut.rojo.projectFile": "default.project.json",
  "lunaut.rojo.sourcemapFile": "sourcemap.json",
  "lunaut.rojo.autogenerate": true,
  "lunaut.rojo.includeNonScripts": true,
  "lunaut.rojo.strictDatamodelTypes": false,
  "lunaut.diagnostics.includeDependents": true,
  "lunaut.diagnostics.workspace": false,
  "lunaut.ignoreGlobs": [],
  "lunaut.completion.autoImports": true,
  "lunaut.completion.importKeyword": "const",
  "lunaut.completion.autocompleteEnd": true,
  "lunaut.hover.documentation": true,
  "lunaut.inlayHints.parameterNames": "literals",
  "lunaut.inlayHints.variableTypes": false,
  "lunaut.inlayHints.functionReturnTypes": false,
  "lunaut.format.convertQuotes": true
}
